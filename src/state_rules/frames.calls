# The frames of the host a thread can stand in, and what a saved state does
# with each.
# tools/state_frames.py reads this list at every build of the host and stops
# the build for a function that runs the guest, calls into it, suspends a
# thread or hands a tail position on, and is not here.
#
#   loop        runs the guest itself (calls Application::Step)
#   entry       the first frame of a fiber; a load makes it anew
#   resumable   a state is taken with this frame on the stack, and the frame
#               is built again after a load
#   restart     a wait; the call is made again from its gate after a load
#   transient   a state waits until the thread has left the frame
#   sites=N     reviewed number of compiled callback/wait/tail sites; a
#               changed count stops the build even in a function already here
#
# A transient frame is safe without anybody's care: Call keeps no tail for
# it, so MachineState::CanSave refuses while a thread is inside. What a line
# decides is whether a program can stay there for long; then the frame needs
# a record or a tail. The lines "one callback inside a call" were entered
# together on 14 October 2026 from the measurement over the collection (no
# program stayed in one of them), not each from its own reading. The probe
# now reports every function in a blocked thread seen continuously for
# 200 ms; the survey and random-state runs retain the transient functions.

# The loops that run the guest.
loop       X86::Application::Run sites=2  # the routine of a thread: a load starts it on a new fiber, and it goes on from the registers (ResumeThread)
loop       X86::Application::Call sites=4  # a callback of the flat side; its mark keeps the registers below and what the caller has left (call_marks, ResumeCall)
loop       X86::Application::Win16Invoke sites=1  # a window procedure of the 16-bit side; the same mark as Call
loop       X86::Application::ResumeCall sites=1  # the loop of Call and Win16Invoke for a callback out of a state
loop       X86::Application::Win16CallPascal sites=1  # a Pascal callback; only the recorded primary Win16 page-release caller has a resumable mark, enumeration/sort remain transient
loop       X86::Application::Win16FontCallback sites=1  # the callback of EnumFonts of the 16-bit side; no mark, so no state while it runs
loop       X86::Application::Win16HookCallback sites=1  # a hook procedure of the 16-bit side; no mark, so no state while it runs
loop       X86::Application::Win16WordBreakCallback sites=1  # the word break procedure of an edit control, 16-bit; no mark, so no state while it runs
loop       X86::Application::Win16HostedCall sites=2  # recorded library initialization keeps paired CPU registers and hosted-stack aliases; unrecorded driver/thunk callers still refuse
loop       X86::Application::Win16CallExit sites=1  # the exit procedure of a 16-bit library; no mark, so no state while it runs
loop       X86::Application::Win16EnterLibrary sites=2  # LibMain of a 16-bit library; no mark, so no state while it runs
loop       X86::Application::Win16LibraryEntryPoint sites=1  # the entry of a 16-bit library; no mark, so no state while it runs

# The first frame of a fiber.
entry      MachineState::Machine::LoadProcess::lambda::call sites=2  # starts the restored Win16 or Win32 fiber in Run
entry      X86::Application::CreateThread::lambda::call sites=1  # starts the new guest thread in Run
entry      X86::Application::Start::lambda::call sites=1  # starts the main Win32 fiber in Run
entry      X86::Application::StartWin16::lambda::call sites=1  # starts the main Win16 fiber in Run

# Frames a state is taken with.
resumable  X86::Application::FaultBox sites=1  # final exception UI recorded separately; after load Close terminates the process
resumable  X86::Application::Api sites=13  # callback/modal gates preserve their stated tail; GetMessage/PeekMessage record only a requested native settings section and its original arguments
resumable  X86::Application::BuildMessageBox sites=2  # record HostMessageBox, when it is the handler of its gate (TakeFresh); FinishMessageBox is the rest
resumable  X86::Application::CallWindow sites=5  # hands the tail on to the procedure of the window and to DialogProcedure, on the straight way only
resumable  X86::Application::SendDispatch sites=3  # passes the tail on the straight window path and both synchronous cross paths
resumable  X86::Application::DialogMessage sites=3  # out of the modal loop: Enter, Escape and the final button mnemonic command keep their continuation
resumable  X86::Application::DialogProcedure sites=1  # record HostDialogProcedure around the procedure of the program; entered again, it does not reset the result
resumable  X86::Application::DialogProcedure::E::Call sites=3  # the call of DialogProcedure into the program, or the rest of it out of a state (ResumeInner)
resumable  X86::Application::Dispatch sites=1  # tells the handler of a gate of the list TailGate that it is the gate's (TailFresh); FinishGate is its end out of a state
resumable  X86::Application::IndirectDialogApi sites=3  # records creation before WM_INITDIALOG, modal loop and owner restoration
resumable  X86::Application::ResumeGuest sites=2  # builds the frames of one level again
resumable  X86::Application::ResumeInner sites=2  # what a recorded frame had called
resumable  X86::Application::RunModal sites=7  # record HostModal: the loop of a modal dialog; a state is taken while it waits or while a procedure it called runs
resumable  X86::Application::Win16Deliver sites=6  # records its staging, copy-back, stack and wheel restoration before invoking the procedure
resumable  X86::Application::Win16DialogFrom sites=3  # records creation before WM_INITDIALOG and enters the modal loop after the resumed initialization
resumable  X86::Application::Win16Transition sites=1  # tells the handler of a 16-bit gate of the list TailGate that it is the gate's; Win16GateReturn is its end out of a state
resumable  X86::Application::Win16UserCall sites=6  # USER.111, 114 and 122 say what is left after their last call; an answer to carry back clears the tail

resumable  X86::Application::CreateWindow sites=3  # records normal creation and the built-in EDIT notification path; unrecorded fallbacks keep TailNone
resumable  X86::Application::DispatchPaint sites=4  # HostDispatchPaint resumes WM_PAINT before restoring dispatch flags and serving remaining frame/erase work
resumable  X86::Application::ContinueCreateWindow sites=1  # restores the interrupted notification, then advances the recorded creation phase
resumable  X86::Application::ContinueCreateWindow::lambda::call sites=9  # every call records its next phase, including EDIT EN_UPDATE/EN_CHANGE (11/7); failed() callers share phase 4
resumable  X86::Application::CreateDialogTemplate sites=3  # records WM_INITDIALOG and the remaining focus/show work after deleting the parsed template
resumable  X86::Application::Win16CreateWindow sites=3  # records the edit limit after common window creation

# Waits that are made again.
restart    X86::Application::Service sites=1  # a gate that waits: the thread stands at the gate, and the call is made again (the list `restartable` of src/x86_state_machine.cpp says for which calls that is right)
restart    X86::Application::Step sites=2  # the end of a time slice, between two instructions of the guest: the thread goes on from its registers
restart    X86::Application::ThreadApi sites=2  # Sleep and the waits for one object: made again from the gate
restart    X86::Application::MultiwaitEnvironment::Wait sites=1  # the waits for several objects and for messages: made again from the gate
restart    X86::Application::WaitCritical sites=1  # EnterCriticalSection: made again from the gate
restart    X86::Application::HalWaitForVerticalBlank sites=1  # the wait for the retrace of the DirectDraw driver: made again from the gate
restart    X86::Application::DxWaitForVerticalBlank sites=1  # the same of the older driver
restart    X86::Application::WaitScreenFree sites=1  # Lock of the screen while others draw: it has changed nothing before it waits
restart    X86::Application::ThreadControlEnvironment::WaitSuspend sites=2  # self-suspension resumes from the recorded thread-control gate
restart    X86::Application::RunMultimediaTimerThread sites=2  # the multimedia thread of the port: saved between two turns, and it begins its loop anew

# Waits and loops a state waits for.
resumable  X86::Application::RunMenuLoop sites=5  # HostMenu resumes the loop, preserving WM_ENTERIDLE delivery in a; the saved USER session finishes after the loop
resumable  X86::Application::DefaultKeyMessage sites=4  # HostBarMenu preserves the key-release cleanup; SYSCHAR returns zero after its system command
resumable  X86::Application::KeyMenuCommand sites=2  # HostBarMenu preserves USER's bar/popup session and consumes the keyboard beep after it closes
resumable  X86::Application::MenuTrackingApi sites=2  # record HostPopupMenu for the gate; USER's session cleanup runs after the loaded loop returns
resumable  X86::Application::BuildFileDialog sites=3  # heap FileDialogFrame plus HostFileDialog; the loaded loop runs the same cleanup
resumable  X86::Application::Win16FileDialog sites=4  # heap Win16OpenFrame plus HostFileDialog; the loaded loop restores the directory and releases staging
resumable  X86::Application::DefaultWindowMessage sites=9  # record HostSizeMove for a DefWindowProc gate, and tail calls for the caption/resize system command
resumable  X86::Application::RunFrameTrackLoop sites=4  # record HostFrameTrack for DefWindowProc's move/size/scroll command; other callers still wait
resumable X86::Application::ResumeDosVm sites=1 # exact restored native DOS root, then its saved UI continuations
resumable X86::Application::RunDosVmLoop sites=3 # native DOS root 56 with captured message tails and an explicitly combined provider
resumable  X86::Application::ContinueSentWait sites=2  # a typed sender continuation resolves process/slot/ticket and retains its wait across a load
transient  X86::Application::LockLoader sites=3  # waits for the loader lock another thread holds while its DllMain runs
transient  X86::Application::TerminateModules sites=1  # the end of a process: DllMain of every library, and the wait for the loader lock
transient  X86::Application::WaitForPlayedSound sites=1  # synchronous PlaySound waits here; a save waits for the sound and its source cleanup to finish
transient  X86::Application::MciCommand sites=1  # an MCI command with the wait flag: waits for the end of the playback
transient  X86::Application::WaitForInputIdleApi sites=1  # waits until another process reads its messages
transient  X86::Application::PreemptThreadControl sites=2  # gives the turn to a thread just resumed or of higher priority, inside the call that did it
transient  X86::Application::ConsoleApi sites=2  # a console read that waits for a key, and the handler of Ctrl+C
transient  X86::Application::KernelPipesApi sites=2  # a pipe that waits for its other end
transient  X86::Application::PipeApi sites=1  # a pipe that waits for its other end
transient  X86::Application::KernelAsyncApi sites=2  # a wait for an overlapped operation of the port
resumable  X86::Application::CommApi sites=2  # CommConfigDialogA keeps its outer error/BOOL and DLL-release continuation; serial event waits remain transient
transient  X86::Application::CommApi::Environment::Wait sites=1  # VCOMM wait retains its event loop and port bookkeeping until completion
transient  X86::Application::LegacyProcessEnvironment::WaitThread sites=1  # WinExec and LoadModule wait until the new program is idle
transient  X86::Application::DragDetect sites=1  # waits for the mouse to move or the button to be released (a fraction of a second)
transient  X86::Application::DragObject sites=1  # a drag of the shell: waits for the button to be released
transient  X86::Application::Wsock2Echo sites=1  # ICMP echo: waits for the answer or its timeout

# One callback, or a few, inside a call of the system that has work left after it.
transient  X86::Application::DateTimeFormatApi::E::Callback sites=1  # format enumeration retains its iteration and staging allocation
transient  X86::Application::MonitorsApi::lambda::call sites=1  # monitor enumeration completes its current callback
transient  X86::Application::PropertySheetEnvironment::Callback sites=1  # page callback completes within its enclosing recorded phase
transient  X86::Application::DragDropEnvironment::Invoke sites=6  # OLE drag callback retains the current drag operation
transient  X86::Application::CrtThreads::InvokeNoArgs sites=6  # CRT thread hooks complete before entering or leaving the thread
resumable  X86::Application::CrtThreads::InvokeThread sites=4  # records the CRT root callback and resumes PTD/handle cleanup after its return; two emitted Call sites cover legacy and extended startup
transient  X86::Application::CensusImportApi sites=2  # one callback inside a call
transient  X86::Application::CollectModules sites=1  # one callback inside a call
resumable  X86::Application::CommApi::Driver::CallDriver sites=3  # a CommConfigDialogA guest provider returns into HostCommConfig; other driver callbacks remain transient
resumable  X86::Application::CommApi::Driver::Thunk16 sites=2  # native SerialUI keeps its outer BOOL conversion and hands presentation to a recorded controller
resumable  X86::Application::ResumeSerialUiDialog sites=1  # resumes the inner dialog before applying DCB and freeing the heap controller, scratch and module
resumable  X86::Application::SerialUiAdvanced sites=3  # heap controller and phased HostSerialAdvanced modal continuation
resumable  X86::Application::SerialUiDialog sites=3  # heap DCB/config/controller ownership; modal property API is the recorded inner call
resumable  X86::Application::SerialUiMessage sites=2  # only the Advanced-button section records its remaining TRUE return after the nested modal call
resumable  X86::Application::CloseProgramDialog sites=2  # only the actual CAD system thread records modal presentation and its later focus/flag/shutdown completion
resumable  X86::Application::CloseProgramDialogMessage sites=2  # only the End Task command records the parent-dialog close after its task API returns
resumable  X86::Application::ConfirmEndTask sites=2  # the target task remains in HostEndTask until the confirmation result is normalized and termination finishes
resumable  X86::Application::EndTaskDialog sites=3  # a recorded confirmation owns the modal call and its result normalization
resumable  X86::Application::ResumeCloseProgramDialog sites=1  # a specifically validated CAD system-thread root rebuilds its records, then performs ExitThread/TLS completion
resumable  X86::Application::UserSessionApi sites=1  # only the EndTask gate consumes a fresh tail and records its pending confirmation; other session APIs remain transient
transient  X86::Application::CommonMemory::Compare sites=1  # one callback inside a call
transient  X86::Application::CplEntry16::lambda::call sites=2  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::CrtApi sites=1  # one callback inside a call
transient  X86::Application::CrtApi::Environment::Invoke sites=1  # CRT hook callback returns through its current API call
transient  X86::Application::CryptoAcquire sites=1  # one callback inside a call
transient  X86::Application::CryptoProviderCall::lambda::call sites=24  # provider callback retains the enclosing crypto operation
transient  X86::Application::DdeCallback sites=4  # one callback inside a call
transient  X86::Application::DeliverApcs sites=1  # one callback inside a call
transient  X86::Application::DrawStateApi::lambda::call sites=1  # one callback inside a call
transient  X86::Application::EditWordBreak sites=2  # one callback inside a call
transient  X86::Application::EnhancedPlay sites=1  # one callback inside a call
transient  X86::Application::EnumIcmProfiles sites=1  # one callback inside a call
transient  X86::Application::EnumProperties sites=1  # one callback inside a call
transient  X86::Application::ExceptionEnvironment::FilterCall sites=1  # one callback inside a call
transient  X86::Application::ExceptionEnvironment::Handler sites=1  # after the handler Call it must unlink its SEH guard and free dispatcher storage
transient  X86::Application::ExceptionEnvironment::ThreadTerminate sites=1  # RtlUnwind runs cleanup handlers; after Call it checks abandonment and terminates the process, with no saved continuation
transient  X86::Application::FindEnvironment::Hook sites=2  # one callback inside a call
transient  X86::Application::FlatThunkHostedCall sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::FontQueryApi::E::Callback sites=2  # font enumeration retains its iteration and output buffers
transient  X86::Application::Gdi32GateApi sites=1  # one callback inside a call
transient  X86::Application::GdiPixelFormatApi sites=1  # one callback inside a call
transient  X86::Application::GlidePageApi sites=3  # one callback inside a call
transient  X86::Application::HookEnvironment::Callback sites=1  # one callback inside a call
transient  X86::Application::InitializeModule sites=1  # one callback inside a call
transient  X86::Application::InstallableDriverSend sites=6  # one callback inside a call
transient  X86::Application::KernelOrdinalsBApi sites=2  # one callback inside a call
transient  X86::Application::ListMessage::lambda::call sites=1  # list comparison callback retains the current control operation
transient  X86::Application::MciHelperCall sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::MessageBoxMessage sites=1  # one callback inside a call
transient  X86::Application::MetafileApi sites=1  # one callback inside a call
transient  X86::Application::MidiNotify sites=1  # one callback inside a call
transient  X86::Application::MixerControlChanged sites=1  # one callback inside a call
transient  X86::Application::MmioCall sites=1  # one callback inside a call
transient  X86::Application::NlsExtendedApi sites=2  # one callback inside a call
transient  X86::Application::NotifyModules sites=1  # one callback inside a call
transient  X86::Application::PifAdvancedMessage::lambda::call sites=1  # one callback inside a call
transient  X86::Application::PifChangeIcon sites=1  # one callback inside a call
transient  X86::Application::PrintCall sites=7  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::PrintEngineEnumerate sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::PrintQueryAbort sites=3  # one callback inside a call
transient  X86::Application::PrintSetupCall sites=2  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::PrinterSetupApi sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::ProcessWinEvents sites=1  # one callback inside a call
transient  X86::Application::ResourceApi sites=2  # one callback inside a call
transient  X86::Application::RunWin16MmThread sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::ShellControlEnvironment::Applet sites=3  # one callback inside a call
transient  X86::Application::ShellCopyApi::Environment::Allocate sites=1  # one callback inside a call
transient  X86::Application::ShellProcessReferenceEnvironment::AddRef sites=1  # one callback inside a call
transient  X86::Application::ShellThreadEnvironment::ComInitialize sites=2  # one callback inside a call
transient  X86::Application::ShellThreadEnvironment::ComUninitialize sites=1  # one callback inside a call
transient  X86::Application::ShellThreadEnvironment::Invoke sites=7  # one callback inside a call
transient  X86::Application::ShellThreadEnvironment::ProcessRef sites=1  # one callback inside a call
resumable  X86::Application::ShowPropertySheet sites=1  # creates the owned sheet operation for PRECREATE, dialog creation, modal result and normal page release
resumable  X86::Application::PropertySheetApi sites=2  # gate-owned header scratch survives presentation; the loaded ANSI path releases converted strings before returning
resumable  X86::Application::ResumePropertyApi sites=1  # resumes the recorded sheet before freeing its public-header scratch
resumable  X86::Application::PropertyPageApi sites=3  # gate or owned collection records the created Unicode page; callback return resumes handle/refcount/string cleanup
resumable  X86::Application::PropertyPageApi::E::Callback sites=3  # only the page API's own frame passes TailRecord; an unrecorded native caller keeps its stack guard
resumable  X86::Application::PropertySheetEnvironment::CreatePage sites=3  # only a registered collection hands its unfinished input cursor to the page API
resumable  X86::Application::ContinuePropertyCollect sites=2  # preserves descriptor cursor, output count and presentation phase without recreating completed pages
transient  X86::Application::SpoolAbortPrinter sites=2  # one callback inside a call
transient  X86::Application::SpoolOpenPrinter sites=1  # one callback inside a call
transient  X86::Application::SpoolPrinterCall sites=1  # one callback inside a call
transient  X86::Application::SpoolStartDoc sites=1  # one callback inside a call
transient  X86::Application::SpoolWritePrinter sites=1  # one callback inside a call
transient  X86::Application::UpdateIcmRegKey sites=6  # one callback inside a call
transient  X86::Application::WaveInNotify sites=1  # one callback inside a call
transient  X86::Application::WaveOutNotify sites=1  # one callback inside a call
transient  X86::Application::Win16CaptureNotify sites=1  # capture's MM_DRVM_DATA callback runs hosted 16-bit code without a recorded continuation
transient  X86::Application::Win16ColorDialog::Hook sites=1  # color hook returns to the enclosing recorded controller phase
resumable  X86::Application::Win16ColorDialog::Initialize sites=1  # only the final Init hook gets a tail after all controller preparation
resumable  X86::Application::Win16ColorDialogMessage sites=2  # Init and ordinary Message phases preserve the hook result and remaining controller work
resumable  X86::Application::Win16DestroyPropertyPage sites=5  # only primary Win16 page releases record callback return before selector disposal; hosted secondary-engine calls remain refused
transient  X86::Application::Win16DpaCall::lambda::call sites=6  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::Win16EnterLibraries sites=2  # 16-bit code inside one call (a driver, a library entry, an enumeration)
resumable  X86::Application::Win16FontDialog::Initialize sites=1  # only the final Init hook gets a tail after all controller preparation
resumable  X86::Application::Win16FontDialogMessage sites=2  # Init and ordinary Message phases preserve the post-hook ready/ended check and controller work
transient  X86::Application::Win16FreeLibrary sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::Win16HostedExit::lambda::call sites=2  # library exit callback completes before the hosted library is released
transient  X86::{anon}::CallTspProvider sites=1  # provider enumeration, initialization and shutdown finish before a state can be saved
transient  X86::Application::Win16KernelCall sites=2  # one callback inside a call
transient  X86::Application::Win16LoadNamedLibrary sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
resumable  X86::Application::Win16PrintDialogMessage sites=3  # Message phase preserves the original live flag, hook result and Print/Setup remainder
transient  X86::Application::Win16PrintDialogs::AdvancedSetup sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
resumable  X86::Application::Win16PrintDialogs::Hook sites=2  # only the completed initializer passes a record for its final Init hook
resumable  X86::Application::Win16PropertyPageMessage sites=8  # primary Win16 page dispatch records result narrowing and NC-destroy registration retirement
transient  X86::Application::Win16SendDriverMessage sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::Win16Shell32 sites=1  # the SHELL32 call must return before Win16FlatLeave restores the saved flat context
transient  X86::Application::Win16SlThunk sites=1  # one callback inside a call
transient  X86::Application::Win16ToolhelpNotify sites=1  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::Win16UserMore sites=1  # EnumWindows/EnumChildWindows call the program's far procedure without an enumeration continuation
transient  X86::Application::Win16WaveOutCallback sites=2  # 16-bit code inside one call (a driver, a library entry, an enumeration)
transient  X86::Application::WinEventNotify sites=1  # one callback inside a call
resumable  X86::Application::WindowApi sites=4  # SendMessageTimeout records its result-store remainder; other callbacks clear the tail
transient  X86::Application::WinmmCompletionApi sites=1  # one callback inside a call

resumable  X86::Application::ProcessSentMessages sites=3  # typed delivery keeps the exact record identity, active send and extra-info; first USER-wait delivery uses TailAgain
resumable  X86::Application::ResumeSentDelivery sites=1  # resumes the callback before finishing the one matching delivery
resumable  X86::Application::SendCrossProcessRaw sites=1  # queues once and records the typed sender wait; load never queues it again
resumable  X86::Application::SendCrossProcess sites=1  # direct GiveTail plus three PushHostFrame sites: GETTEXT, SETTEXT/settings string and COPYDATA
resumable  X86::Application::SendCrossProcess::lambda::call sites=6  # three inlined GiveTail sites; each copied allocation is kept by HostSendCopy until return
resumable  X86::Application::Win16ChooseColor sites=4  # heap controller, creating API record and final native Init hook remainder
resumable  X86::Application::Win16ChooseFont sites=4  # heap controller, creating API record and final native Init hook remainder
resumable  X86::Application::Win16PrintDialog sites=2  # HostWin16PrintApi holds the API scratch and cursor/extended-error remainder
resumable  X86::Application::Win16PrintDialogs::Run sites=3  # heap print controller owns template staging and the recorded Init/modal lifecycle
resumable  X86::Application::Win16PrintDialogs::PrintCommand sites=1  # only Setup has a record for its repeated run and command remainder
resumable  X86::Application::DialogCharacter sites=2  # a found button mnemonic consumes the message after its final WM_COMMAND
resumable  X86::Application::DialogGotoMnemonic sites=2  # only direct button WM_COMMAND is a tail; querying codes, moving focus and radio handling stay transient
resumable  X86::Application::PifPropertySheet sites=3  # guest scratch owns pages/templates/header/module; only phase 1 records the sheet call and phase 2 releases it
resumable  X86::Application::PifAdvancedDialog sites=3  # records only the initialized Advanced modal loop and clears the page globals afterward
resumable  X86::Application::PifPageMessage sites=2  # only command 4008 preserves the post-Advanced enable/real-mode control update and TRUE return
resumable  X86::Application::DosVmToolbarClick sites=2  # a recorded Properties/Font caller preserves timer/flags/window invalidation and the outer mouse reset
resumable  X86::Application::DosVmWindowMessage sites=2  # forwards the actual window-message tail only to toolbar clicks (also the host's properties request); other messages do not gain a record
resumable  X86::Application::ServeOpenRequests sites=1  # the GetMessage/PeekMessage owner preserves its arguments; each settings request uses its own PIF record

# Native PropertySheet preparation and release callbacks.
resumable  X86::Application::CbtDestroyEnvironment::Send sites=3  # only recorded sheet or RemovePage WM_NCDESTROY retains USER disposal after the callback
resumable  X86::Application::ContinuePropertyInit sites=2  # heap tab/start/eager-page progress resumes INITIALIZED, creation and initial activation
resumable  X86::Application::ContinuePropertySheet sites=2  # heap template, PRECREATE, dialog creation, modal result and release phases
resumable  X86::Application::PropertySheetEnvironment::ContinueActivate sites=1  # takes up its child before advancing page selection and visibility
resumable  X86::Application::PropertySheetEnvironment::ContinueNotify sites=1  # retains the guest NMHDR through Send and reads DWL_MSGRESULT once
resumable  X86::Application::PropertySheetEnvironment::ContinuePageWindow sites=2  # retains the CREATE return and copied template through WM_INITDIALOG
resumable  X86::Application::PropertySheetEnvironment::ContinueRelease sites=1  # resumes destruction once and walks the remaining page handles backwards
resumable  X86::Application::PropertySheetEnvironment::ContinueRemove sites=2  # captures page WM_NCDESTROY only under its matching window/phase record, then RELEASE and array cleanup
resumable  X86::Application::PropertySheetEnvironment::Notify sites=1  # stages a guest notification and records its result/cleanup
resumable  X86::Application::PropertySheetEnvironment::Phase sites=32  # only its own typed registered operation passes TailRecord; slot/thread/phase validated when saving
resumable  X86::Application::ResumePropertyWork sites=4  # resolves the exact typed operation or the tightly registered modal/nonclient cleanup
resumable  X86::Application::PropertySheetEnvironment::Begin sites=32  # creates a typed operation for the exact caller and clears inherited tail promises
resumable  X86::Application::PropertySheetEnvironment::ContinueApply sites=1  # restores veto/page index/result/change flags before applying the remaining pages
resumable  X86::Application::PropertySheetEnvironment::ContinueCommand sites=2  # resumes cancellation, application or the reverse extra-notification loop exactly once
resumable  X86::Application::PropertySheetEnvironment::ContinueSetCurrent sites=2  # keeps index, direction and tab selection result across KILLACTIVE and SETACTIVE

resumable  X86::Application::Win16PropertySheet sites=3  # primary Win16 gate keeps its converted page/template owner through native sheet return and release callbacks
resumable  X86::Application::FinishWin16PropertySheet sites=2  # remaining reverse page-release loop is owned by the persistent controller; each release passes its record

