# Saved-state field rules. See state.rules for the rule format.
# Pointer fields must identify their allocation or target object.

# ---- Open modal dialogs: a chain of frames on the host stack of the call ----
var X86::Application::Win16SheetState::head none                 # heap owners of converted sheet pages, templates and pending page releases
# A thread inside one of these calls stands at no save point (CanSave names
# the call), so the chain is not part of a state; a variable that still
# holds a frame only says that such a call is open.
var X86::(anonymous namespace)::SheetFrame::head none            # owns heap property-sheet controllers and their typed continuation records
var X86::Application::PropertyWork::head none                   # typed unfinished property-sheet operations; frame index, thread and phase identify the owner
field X86::Application::PropertyWork::bytes bytes size          # copied dialog template retained until the recorded creation returns
var X86::(anonymous namespace)::SerialUiFrame::head none         # owns active serial controllers and permanent EnumPropPages pages

# ---- Menus ----
field Win98Menu::Menu::items count count                         # the items of a menu; behind its count lie items that were deleted, with texts that are freed (PURBLE)

var X86::Application::Win16FileWork::head none                    # typed pending file operations; exact thread/frame/phase ownership
field X86::(anonymous namespace)::Win16OpenFrame@win16_commdlg.cpp::template_bytes bytes template_size # copied template remains owned until the final init hook returns

# Compiled USER providers are installed by Application::BindUserProviders before
# LoadFields. Never resolve their compiler-numbered lambda symbols from a state:
# a number can be reused for another callback, including another signature.
# The separate *_context variables remain serialized Application references.
var User::(anonymous namespace)::caret_draw host # compiled provider installed before loading saved contexts
var User::(anonymous namespace)::caret_destroy host # compiled provider installed before loading saved contexts
var User::(anonymous namespace)::caret_bracket host # compiled provider installed before loading saved contexts
