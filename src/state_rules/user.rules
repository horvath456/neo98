# Native class translation storage follows its allocated element count.
field Win98ClassStore::Store::modules count module_capacity # allocated module tokens, including reusable slots
field Win98ClassStore::Store::handles count handle_capacity # allocated graphics-handle tokens
field Win98ClassStore::Store::bodies count body_capacity # allocated class bodies, including reusable slots
