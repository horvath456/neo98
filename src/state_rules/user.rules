var User::(anonymous namespace)::menu_send host # compiled provider installed before loading saved contexts
var User::(anonymous namespace)::menu_loop host # compiled provider installed before loading saved contexts
var User::(anonymous namespace)::menu_thread host # compiled provider installed before loading saved contexts
var User::(anonymous namespace)::menu_measure host # compiled provider installed before loading saved contexts
var User::(anonymous namespace)::menu_draw host # compiled provider installed before loading saved contexts
var User::(anonymous namespace)::property_cleanup host # compiled provider installed before loading saved contexts
