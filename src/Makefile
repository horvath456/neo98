# kernel.h includes x86_app.h and its C ABI types in x86_state.h.
main.o main.d kernel.o kernel.d mines_ui.o mines_ui.d gdi_ui.o gdi_ui.d editor_ui.o editor_ui.d app_ui.o app_ui.d: EXTRAINCLUDE += -I../third_party/aarch64-newlib/include -isystem $(shell clang -print-resource-dir)/include
app_ui.o app_ui.d: EXTRAINCLUDE += -I$(NEO98_APP_ASSETS)
circle_host.o: ../platform/circle/host.cpp
	@echo "  CPP   $@"
	@$(CPP) $(CPPFLAGS) -c -o $@ $<
circle_host.d: ../platform/circle/host.cpp
	@$(CPP) $(CPPFLAGS) -M -MG -MT circle_host.o -MT $@ -MF $@ $<

include $(CIRCLEHOME)/Rules.mk
# A case of an API switch must end in return or break.
CPPFLAGS += -Werror=implicit-fallthrough
# Circle compiles with -nostdinc++; the kernel's own <new> lives here.
CPPFLAGS += -isystem ../platform/circle/include
# The dependency scan runs with -MG and names a header it cannot find as a
# plain file ("new"). GNU make 3.81 then fails to remake the included .d file
# and stops with status 2 without a message. Without a rule of its own such a
# name counts as remade: the .d file is scanned again and the compiler reports
# a header that is really missing by name.
.DEFAULT: ;
-include $(DEPS)

x86_vga.o x86_vga.d: EXTRAINCLUDE += -I../third_party/aarch64-newlib/include -isystem $(shell clang -print-resource-dir)/include
