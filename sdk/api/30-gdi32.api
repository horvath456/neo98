const SRCPAINT 0x00EE0086UL;
const SRCAND 0x008800C6UL;
const SRCINVERT 0x00660046UL;
const PATCOPY 0x00F00021UL;
const BLACKNESS 0x00000042UL;
const WHITENESS 0x00FF0062UL;
const R2_COPYPEN 13;
const R2_NOT 6;
const R2_XORPEN 7;
const TA_LEFT 0;
const TA_RIGHT 2;
