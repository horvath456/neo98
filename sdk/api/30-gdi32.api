const BS_HATCHED 2;
int GetObjectA(HANDLE h, int c, LPVOID pv) object;
DWORD GetObjectType(HGDIOBJ h);
HGDIOBJ GetCurrentObject(HDC hdc, UINT type);
int CombineRgn(HRGN hrgnDst, HRGN hrgnSrc1, HRGN hrgnSrc2, int iMode);
int OffsetRgn(HRGN hrgn, int x, int y);
int GetRgnBox(HRGN hrgn, RECT* lprc);
HRGN CreateRectRgnIndirect(in RECT* lprect);
HRGN CreateRoundRectRgn(int x1, int y1, int x2, int y2, int w, int h);
HRGN CreateEllipticRgn(int x1, int y1, int x2, int y2);
BOOL FillRgn(HDC hdc, HRGN hrgn, HBRUSH hbr);
BOOL PtInRegion(HRGN hrgn, int x, int y);
int ExtEscape(HDC hdc, int iEscape, int cjInput, LPCSTR lpInData, int cjOutput, LPSTR lpOutData);
int GetDIBits(HDC hdc, HBITMAP hbm, UINT start, UINT cLines, LPVOID lpvBits, BITMAPINFO* lpbmi, UINT usage);
int SetDIBits(HDC hdc, HBITMAP hbm, UINT start, UINT cLines, LPCVOID lpBits, in BITMAPINFO* lpbmi, UINT ColorUse);
int GetTextFaceA(HDC hdc, int c, LPSTR lpName);
BOOL SetPixelV(HDC hdc, int x, int y, COLORREF color);
int SetStretchBltMode(HDC hdc, int mode);
int GetStretchBltMode(HDC hdc);
BOOL SetViewportOrgEx(HDC hdc, int x, int y, POINT* lppt);
BOOL SetBrushOrgEx(HDC hdc, int x, int y, POINT* lppt);
