# WINMM: wave output, the multimedia timer, PlaySound, the mixer, MCI strings.
# The structs of mmsystem.h are packed to one byte.
type MMRESULT   u32    "unsigned int";
type MCIERROR   u32    "unsigned long";
type MCIDEVICEID u32   "unsigned int";
type FOURCC     u32    "unsigned long";
handle HWAVEOUT;
handle HMIXER;
handle HMIXEROBJ;

struct WAVEFORMATEX packed { WORD wFormatTag; WORD nChannels; DWORD nSamplesPerSec; DWORD nAvgBytesPerSec; WORD nBlockAlign; WORD wBitsPerSample; WORD cbSize; };
struct WAVEFORMAT packed { WORD wFormatTag; WORD nChannels; DWORD nSamplesPerSec; DWORD nAvgBytesPerSec; WORD nBlockAlign; };
struct PCMWAVEFORMAT packed { WAVEFORMAT wf; WORD wBitsPerSample; };
type LPWAVEFORMATEX ptr "WAVEFORMATEX *";
type LPCWAVEFORMATEX ptr "const WAVEFORMATEX *";
# The system keeps the address of a header from waveOutPrepareHeader to
# waveOutUnprepareHeader and writes dwFlags while the block plays.
struct WAVEHDR packed { LPSTR lpData; DWORD dwBufferLength; DWORD dwBytesRecorded; DWORD_PTR dwUser; DWORD dwFlags; DWORD dwLoops; WAVEHDR* lpNext; DWORD_PTR reserved; };
struct WAVEOUTCAPSA packed { WORD wMid; WORD wPid; UINT vDriverVersion; CHAR szPname[32]; DWORD dwFormats; WORD wChannels; WORD wReserved1; DWORD dwSupport; };
struct MMTIME packed { UINT wType; union { DWORD ms; DWORD sample; DWORD cb; DWORD ticks; struct { BYTE hour; BYTE min; BYTE sec; BYTE frame; BYTE fps; BYTE dummy; BYTE pad[2]; } smpte; struct { DWORD songptrpos; } midi; } u; };
struct TIMECAPS packed { UINT wPeriodMin; UINT wPeriodMax; };
struct MIXERCAPSA packed { WORD wMid; WORD wPid; UINT vDriverVersion; CHAR szPname[32]; DWORD fdwSupport; DWORD cDestinations; };
struct MIXERLINEA packed { DWORD cbStruct sizeof; DWORD dwDestination; DWORD dwSource; DWORD dwLineID; DWORD fdwLine; DWORD_PTR dwUser; DWORD dwComponentType; DWORD cChannels; DWORD cConnections; DWORD cControls; CHAR szShortName[16]; CHAR szName[64];
    struct { DWORD dwType; DWORD dwDeviceID; WORD wMid; WORD wPid; UINT vDriverVersion; CHAR szPname[32]; } Target; };
struct MIXERCONTROLA packed { DWORD cbStruct; DWORD dwControlID; DWORD dwControlType; DWORD fdwControl; DWORD cMultipleItems; CHAR szShortName[16]; CHAR szName[64];
    union { struct { LONG lMinimum; LONG lMaximum; }; struct { DWORD dwMinimum; DWORD dwMaximum; }; DWORD dwReserved[6]; } Bounds;
    union { DWORD cSteps; DWORD cbCustomData; DWORD dwReserved[6]; } Metrics; };
struct MIXERLINECONTROLSA packed { DWORD cbStruct sizeof; DWORD dwLineID; union { DWORD dwControlID; DWORD dwControlType; }; DWORD cControls; DWORD cbmxctrl; MIXERCONTROLA* pamxctrl; };
struct MIXERCONTROLDETAILS packed { DWORD cbStruct sizeof; DWORD dwControlID; DWORD cChannels; union { HWND hwndOwner; DWORD cMultipleItems; }; DWORD cbDetails; LPVOID paDetails; };
struct MIXERCONTROLDETAILS_UNSIGNED packed { DWORD dwValue; };
struct MIXERCONTROLDETAILS_BOOLEAN packed { LONG fValue; };
struct MIXERCONTROLDETAILS_SIGNED packed { LONG lValue; };

# dwParam1 of WOM_DONE is the header that finished.
callback void WAVEOUTPROC(HWAVEOUT hwo, UINT uMsg, DWORD_PTR dwInstance, DWORD_PTR dwParam1 shadow(WAVEHDR), DWORD_PTR dwParam2);
callback void LPTIMECALLBACK(UINT uTimerID, UINT uMsg, DWORD_PTR dwUser, DWORD_PTR dw1, DWORD_PTR dw2);

message MM_WOM_OPEN 0x03BB;
message MM_WOM_CLOSE 0x03BC;
message MM_WOM_DONE 0x03BD lparam keep WAVEHDR;
message MM_MCINOTIFY 0x03B9;
message MM_MIXM_LINE_CHANGE 0x03D0;
message MM_MIXM_CONTROL_CHANGE 0x03D1;

const WOM_OPEN 0x3BB;
const WOM_CLOSE 0x3BC;
const WOM_DONE 0x3BD;
const MMSYSERR_NOERROR 0;
const MMSYSERR_ERROR 1;
const MMSYSERR_BADDEVICEID 2;
const MMSYSERR_ALLOCATED 4;
const MMSYSERR_INVALHANDLE 5;
const MMSYSERR_NODRIVER 6;
const MMSYSERR_NOMEM 7;
const MMSYSERR_NOTSUPPORTED 8;
const MMSYSERR_INVALFLAG 10;
const MMSYSERR_INVALPARAM 11;
const WAVERR_BADFORMAT 32;
const WAVERR_STILLPLAYING 33;
const WAVERR_UNPREPARED 34;
const WAVE_MAPPER ((UINT)-1);
const WAVE_FORMAT_PCM 1;
const WAVE_FORMAT_QUERY 0x0001;
const WHDR_DONE 0x00000001;
const WHDR_PREPARED 0x00000002;
const WHDR_BEGINLOOP 0x00000004;
const WHDR_ENDLOOP 0x00000008;
const WHDR_INQUEUE 0x00000010;
const CALLBACK_TYPEMASK 0x00070000L;
const CALLBACK_NULL 0x00000000L;
const CALLBACK_WINDOW 0x00010000L;
const CALLBACK_THREAD 0x00020000L;
const CALLBACK_FUNCTION 0x00030000L;
const CALLBACK_EVENT 0x00050000L;
const TIME_MS 0x0001;
const TIME_SAMPLES 0x0002;
const TIME_BYTES 0x0004;
const TIME_ONESHOT 0x0000;
const TIME_PERIODIC 0x0001;
const TIME_CALLBACK_FUNCTION 0x0000;
const TIME_CALLBACK_EVENT_SET 0x0010;
const TIME_CALLBACK_EVENT_PULSE 0x0020;
const TIMERR_NOERROR 0;
const TIMERR_NOCANDO 97;
const SND_SYNC 0x0000;
const SND_ASYNC 0x0001;
const SND_NODEFAULT 0x0002;
const SND_MEMORY 0x0004;
const SND_LOOP 0x0008;
const SND_NOSTOP 0x0010;
const SND_NOWAIT 0x00002000L;
const SND_ALIAS 0x00010000L;
const SND_FILENAME 0x00020000L;
const SND_RESOURCE 0x00040004L;
const SND_PURGE 0x0040;
const MIXER_OBJECTF_MIXER 0x00000000L;
const MIXER_OBJECTF_HMIXER 0x80000000L;
const MIXER_OBJECTF_WAVEOUT 0x10000000L;
const MIXER_GETLINEINFOF_DESTINATION 0x00000000L;
const MIXER_GETLINEINFOF_SOURCE 0x00000001L;
const MIXER_GETLINEINFOF_LINEID 0x00000002L;
const MIXER_GETLINEINFOF_COMPONENTTYPE 0x00000003L;
const MIXER_GETLINECONTROLSF_ALL 0x00000000L;
const MIXER_GETLINECONTROLSF_ONEBYID 0x00000001L;
const MIXER_GETLINECONTROLSF_ONEBYTYPE 0x00000002L;
const MIXER_GETCONTROLDETAILSF_VALUE 0x00000000L;
const MIXER_SETCONTROLDETAILSF_VALUE 0x00000000L;
const MIXERLINE_COMPONENTTYPE_DST_SPEAKERS 4;
const MIXERLINE_COMPONENTTYPE_SRC_WAVEOUT 0x1008;
const MIXERCONTROL_CONTROLTYPE_VOLUME 0x50030001L;
const MIXERCONTROL_CONTROLTYPE_MUTE 0x20010002L;

dll WINMM;
DWORD timeGetTime();
MMRESULT timeBeginPeriod(UINT uPeriod);
MMRESULT timeEndPeriod(UINT uPeriod);
MMRESULT timeGetDevCaps(TIMECAPS* ptc, UINT cbtc);
MMRESULT timeSetEvent(UINT uDelay, UINT uResolution, LPTIMECALLBACK fptc when(fuEvent, 0x30, 0), DWORD_PTR dwUser, UINT fuEvent);
MMRESULT timeKillEvent(UINT uTimerID);
UINT waveOutGetNumDevs();
MMRESULT waveOutGetDevCapsA(UINT_PTR uDeviceID, WAVEOUTCAPSA* pwoc, UINT cbwoc);
MMRESULT waveOutOpen(out HWAVEOUT* phwo, UINT uDeviceID, in WAVEFORMATEX* pwfx, DWORD_PTR dwCallback callback(WAVEOUTPROC) when(fdwOpen, 0x70000, 0x30000), DWORD_PTR dwInstance, DWORD fdwOpen);
MMRESULT waveOutClose(HWAVEOUT hwo);
MMRESULT waveOutPrepareHeader(HWAVEOUT hwo, keep WAVEHDR* pwh, UINT cbwh sizeof(pwh));
MMRESULT waveOutUnprepareHeader(HWAVEOUT hwo, drop WAVEHDR* pwh, UINT cbwh sizeof(pwh));
MMRESULT waveOutWrite(HWAVEOUT hwo, keep WAVEHDR* pwh, UINT cbwh sizeof(pwh));
MMRESULT waveOutPause(HWAVEOUT hwo);
MMRESULT waveOutRestart(HWAVEOUT hwo);
MMRESULT waveOutReset(HWAVEOUT hwo);
MMRESULT waveOutBreakLoop(HWAVEOUT hwo);
MMRESULT waveOutGetPosition(HWAVEOUT hwo, MMTIME* pmmt, UINT cbmmt);
MMRESULT waveOutGetVolume(HWAVEOUT hwo, LPDWORD pdwVolume);
MMRESULT waveOutSetVolume(HWAVEOUT hwo, DWORD dwVolume);
MMRESULT waveOutGetID(HWAVEOUT hwo, LPDWORD puDeviceID);
MMRESULT waveOutGetErrorTextA(MMRESULT mmrError, LPSTR pszText, UINT cchText);
BOOL PlaySoundA(LPCSTR pszSound, HMODULE hmod, DWORD fdwSound);
BOOL sndPlaySoundA(LPCSTR pszSound, UINT fuSound);
UINT mixerGetNumDevs();
MMRESULT mixerGetDevCapsA(UINT_PTR uMxId, MIXERCAPSA* pmxcaps, UINT cbmxcaps);
MMRESULT mixerOpen(out HMIXER* phmx, UINT uMxId, DWORD_PTR dwCallback, DWORD_PTR dwInstance, DWORD fdwOpen);
MMRESULT mixerClose(HMIXER hmx);
MMRESULT mixerGetLineInfoA(HMIXEROBJ hmxobj, inout MIXERLINEA* pmxl, DWORD fdwInfo);
MMRESULT mixerGetLineControlsA(HMIXEROBJ hmxobj, inout MIXERLINECONTROLSA* pmxlc, DWORD fdwControls);
MMRESULT mixerGetControlDetailsA(HMIXEROBJ hmxobj, inout MIXERCONTROLDETAILS* pmxcd, DWORD fdwDetails);
MMRESULT mixerSetControlDetails(HMIXEROBJ hmxobj, in MIXERCONTROLDETAILS* pmxcd, DWORD fdwDetails);
MCIERROR mciSendStringA(LPCSTR lpstrCommand, LPSTR lpstrReturnString, UINT uReturnLength, HWND hwndCallback);
BOOL mciGetErrorStringA(MCIERROR mcierr, LPSTR pszText, UINT cchText);

# Wave input and MIDI output. The headers are kept by the system like the
# ones of wave output.
handle HWAVEIN;
handle HMIDIOUT;
struct WAVEINCAPSA packed { WORD wMid; WORD wPid; UINT vDriverVersion; CHAR szPname[32]; DWORD dwFormats; WORD wChannels; WORD wReserved1; };
struct MIDIOUTCAPSA packed { WORD wMid; WORD wPid; UINT vDriverVersion; CHAR szPname[32]; WORD wTechnology; WORD wVoices; WORD wNotes; WORD wChannelMask; DWORD dwSupport; };
struct MIDIHDR packed { LPSTR lpData; DWORD dwBufferLength; DWORD dwBytesRecorded; DWORD_PTR dwUser; DWORD dwFlags; MIDIHDR* lpNext; DWORD_PTR reserved; DWORD dwOffset; DWORD_PTR dwReserved[8]; };
callback void WAVEINPROC(HWAVEIN hwi, UINT uMsg, DWORD_PTR dwInstance, DWORD_PTR dwParam1 shadow(WAVEHDR), DWORD_PTR dwParam2);
callback void MIDIOUTPROC(HMIDIOUT hmo, UINT uMsg, DWORD_PTR dwInstance, DWORD_PTR dwParam1 shadow(MIDIHDR), DWORD_PTR dwParam2);
message MM_WIM_OPEN 0x03BE;
message MM_WIM_CLOSE 0x03BF;
message MM_WIM_DATA 0x03C0 lparam keep WAVEHDR;
message MM_MOM_OPEN 0x03C7;
message MM_MOM_CLOSE 0x03C8;
message MM_MOM_DONE 0x03C9 lparam keep MIDIHDR;
const WIM_OPEN 0x3BE;
const WIM_CLOSE 0x3BF;
const WIM_DATA 0x3C0;
const MOM_OPEN 0x3C7;
const MOM_CLOSE 0x3C8;
const MOM_DONE 0x3C9;
const MIDI_MAPPER ((UINT)-1);
const MHDR_DONE 0x00000001;
const MHDR_PREPARED 0x00000002;
const MHDR_INQUEUE 0x00000004;
UINT waveInGetNumDevs();
MMRESULT waveInGetDevCapsA(UINT_PTR uDeviceID, WAVEINCAPSA* pwic, UINT cbwic);
MMRESULT waveInOpen(out HWAVEIN* phwi, UINT uDeviceID, in WAVEFORMATEX* pwfx, DWORD_PTR dwCallback callback(WAVEINPROC) when(fdwOpen, 0x70000, 0x30000), DWORD_PTR dwInstance, DWORD fdwOpen);
MMRESULT waveInClose(HWAVEIN hwi);
MMRESULT waveInPrepareHeader(HWAVEIN hwi, keep WAVEHDR* pwh, UINT cbwh sizeof(pwh));
MMRESULT waveInUnprepareHeader(HWAVEIN hwi, drop WAVEHDR* pwh, UINT cbwh sizeof(pwh));
MMRESULT waveInAddBuffer(HWAVEIN hwi, keep WAVEHDR* pwh, UINT cbwh sizeof(pwh));
MMRESULT waveInStart(HWAVEIN hwi);
MMRESULT waveInStop(HWAVEIN hwi);
MMRESULT waveInReset(HWAVEIN hwi);
MMRESULT waveInGetPosition(HWAVEIN hwi, MMTIME* pmmt, UINT cbmmt);
UINT midiOutGetNumDevs();
MMRESULT midiOutGetDevCapsA(UINT_PTR uDeviceID, MIDIOUTCAPSA* pmoc, UINT cbmoc);
MMRESULT midiOutOpen(out HMIDIOUT* phmo, UINT uDeviceID, DWORD_PTR dwCallback callback(MIDIOUTPROC) when(fdwOpen, 0x70000, 0x30000), DWORD_PTR dwInstance, DWORD fdwOpen);
MMRESULT midiOutClose(HMIDIOUT hmo);
MMRESULT midiOutShortMsg(HMIDIOUT hmo, DWORD dwMsg);
MMRESULT midiOutPrepareHeader(HMIDIOUT hmo, keep MIDIHDR* pmh, UINT cbmh sizeof(pmh));
MMRESULT midiOutUnprepareHeader(HMIDIOUT hmo, drop MIDIHDR* pmh, UINT cbmh sizeof(pmh));
MMRESULT midiOutLongMsg(HMIDIOUT hmo, keep MIDIHDR* pmh, UINT cbmh sizeof(pmh));
MMRESULT midiOutReset(HMIDIOUT hmo);
MMRESULT midiOutGetVolume(HMIDIOUT hmo, LPDWORD pdwVolume);
MMRESULT midiOutSetVolume(HMIDIOUT hmo, DWORD dwVolume);
