# Scalar types of the Win32 headers. Class says how a value crosses between
# the program (Win64 ABI) and the 32-bit providers; docs/ARM64-APPS.md.
type void       void   "void";
type char       s8     "char";
type short      s16    "short";
type int        s32    "int";
type long       s32    "long";
type float      f32    "float";
type double     f64    "double";
type size_t     uptr   "unsigned long long";
type CHAR       s8     "char";
type BYTE       u8     "unsigned char";
type WORD       u16    "unsigned short";
type WCHAR      u16    "wchar_t";
type SHORT      s16    "short";
type USHORT     u16    "unsigned short";
type INT        s32    "int";
type UINT       u32    "unsigned int";
type LONG       s32    "long";
type ULONG      u32    "unsigned long";
type DWORD      u32    "unsigned long";
type BOOL       s32    "int";
type BOOLEAN    u8     "unsigned char";
type FLOAT      f32    "float";
type ATOM       u16    "unsigned short";
type COLORREF   u32    "unsigned long";
type LCID       u32    "unsigned long";
type LANGID     u16    "unsigned short";
type HRESULT    s32    "long";
type LONGLONG   s64    "long long";
type ULONGLONG  u64    "unsigned long long";
type INT_PTR    sptr   "long long";
type LONG_PTR   sptr   "long long";
type UINT_PTR   uptr   "unsigned long long";
type ULONG_PTR  uptr   "unsigned long long";
type DWORD_PTR  uptr   "unsigned long long";
type SIZE_T     usize  "unsigned long long";
type WPARAM     uptr   "unsigned long long";
type LPARAM     sptr   "long long";
type LRESULT    sptr   "long long";
type PVOID      ptr    "void *";
type LPVOID     ptr    "void *";
type LPCVOID    ptr    "const void *";
type LPSTR      ptr    "char *";
type LPCSTR     ptr    "const char *";
type PSTR       ptr    "char *";
type PCSTR      ptr    "const char *";
type LPWSTR     ptr    "wchar_t *";
type LPCWSTR    ptr    "const wchar_t *";
type LPBYTE     ptr    "unsigned char *";
type LPDWORD    ptr    "unsigned long *";
type LPWORD     ptr    "unsigned short *";
type LPLONG     ptr    "long *";
type LPINT      ptr    "int *";
type LPBOOL     ptr    "int *";
type PFLOAT     ptr    "float *";
type va_list    ptr    "char *";
type HANDLE     handle "void *";
type HGDIOBJ    handle "void *";
type HGLOBAL    handle "void *";
type HLOCAL     handle "void *";
type HRSRC      handle "void *";
handle HWND;
handle HDC;
handle HINSTANCE;
type HMODULE    handle "HINSTANCE";
handle HMENU;
handle HICON;
type HCURSOR    handle "HICON";
handle HBRUSH;
handle HPEN;
handle HFONT;
handle HBITMAP;
handle HRGN;
handle HPALETTE;
handle HACCEL;
handle HKEY;
handle HHOOK;
handle HDWP;

struct POINT { LONG x; LONG y; };
struct SIZE { LONG cx; LONG cy; };
struct RECT { LONG left; LONG top; LONG right; LONG bottom; };
type LPRECT     ptr    "RECT *";
type LPCRECT    ptr    "const RECT *";
type LPPOINT    ptr    "POINT *";
type LPSIZE     ptr    "SIZE *";
struct FILETIME { DWORD dwLowDateTime; DWORD dwHighDateTime; };
struct SYSTEMTIME { WORD wYear; WORD wMonth; WORD wDayOfWeek; WORD wDay; WORD wHour; WORD wMinute; WORD wSecond; WORD wMilliseconds; };
struct LARGE_INTEGER { union { struct { DWORD LowPart; LONG HighPart; }; LONGLONG QuadPart; }; };
struct SECURITY_ATTRIBUTES { DWORD nLength; LPVOID lpSecurityDescriptor; BOOL bInheritHandle; };
struct OVERLAPPED { ULONG_PTR Internal; ULONG_PTR InternalHigh; DWORD Offset; DWORD OffsetHigh; HANDLE hEvent; };
