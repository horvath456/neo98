# NEO98DX: the driver below the ARM64 DDRAW.DLL and DSOUND.DLL.
# It is not an interface for programs: a program
# imports DDRAW.DLL and DSOUND.DLL, and those call here. Every structure is in
# sdk/dx/neo98dx_abi.h and has the same bytes in the Win32 and the Win64
# layout, so every pointer goes through as it is. The results are HRESULTs of
# DirectDraw and DirectSound.
dll NEO98DX;
DWORD DxDrvVersion();

# The display.
HRESULT DdDrvGetInfo(LPVOID info, DWORD bytes);
HRESULT DdDrvGetMode(DWORD index, LPVOID mode, DWORD bytes);
HRESULT DdDrvSetMode(DWORD width, DWORD height, DWORD bits);
HRESULT DdDrvRestoreMode();
HRESULT DdDrvSetExclusive(HWND window, BOOL enter);
HRESULT DdDrvWaitForVerticalBlank(DWORD flags, LPDWORD inVerticalBlank);
HRESULT DdDrvGetScanLine(LPDWORD line);
HRESULT DdDrvSetGammaRamp(LPVOID ramp);
HRESULT DdDrvGetGammaRamp(LPVOID ramp);

# Surfaces of the driver.
HRESULT DdDrvCreateSurface(LPVOID create, DWORD bytes);
HRESULT DdDrvDestroySurface(DWORD surface);
HRESULT DdDrvAttach(DWORD surface, DWORD attached, BOOL attach);
HRESULT DdDrvLock(LPVOID lock, DWORD bytes);
HRESULT DdDrvUnlock(DWORD surface);
HRESULT DdDrvBlt(LPVOID blt, DWORD bytes);
HRESULT DdDrvFlip(LPVOID surfaces, DWORD count, DWORD flags);
HRESULT DdDrvIsLost(DWORD surface);
HRESULT DdDrvRestore(DWORD surface, LPVOID create, DWORD bytes);
HRESULT DdDrvSetPalette(DWORD surface, DWORD start, DWORD count, LPVOID colors, DWORD flags);
HRESULT DdDrvSetColorKey(DWORD surface, DWORD flags, DWORD low, DWORD high);

# GDI on a surface, and the visible region of a window.
HRESULT DdDrvGetDC(LPVOID dc, DWORD bytes);
HRESULT DdDrvReleaseDC(HDC dc);
HRESULT DdDrvGetClipList(HWND window, LPVOID data, LPDWORD bytes);

# Direct3D: the rasterizer below the Direct3D 7 of the SDK. A context is a
# render target with its Z buffer and the state the commands left; D3dDrvRun
# takes one batch of commands (sdk/dx/neo98dx_abi.h, NEO98D3D_OP_).
HRESULT D3dDrvGetCaps(LPVOID caps, DWORD bytes);
HRESULT D3dDrvCreateContext(DWORD target, DWORD depth, LPDWORD context);
HRESULT D3dDrvDestroyContext(DWORD context);
HRESULT D3dDrvRun(DWORD context, LPVOID commands, DWORD bytes);

# Sound.
HRESULT DsDrvOpen();
HRESULT DsDrvGetCaps(LPVOID caps, DWORD bytes);
HRESULT DsDrvCreateBuffer(LPVOID sound, DWORD bytes);
HRESULT DsDrvDuplicateBuffer(DWORD buffer, LPDWORD duplicate);
HRESULT DsDrvDestroyBuffer(DWORD buffer);
HRESULT DsDrvPlay(DWORD buffer, DWORD flags);
HRESULT DsDrvStop(DWORD buffer);
HRESULT DsDrvGetPosition(DWORD buffer, LPDWORD play, LPDWORD write);
HRESULT DsDrvSetPosition(DWORD buffer, DWORD position);
HRESULT DsDrvGetStatus(DWORD buffer, LPDWORD status);
HRESULT DsDrvSetNotifications(DWORD buffer, LPVOID positions, DWORD count);
HRESULT DsDrvSetFormat(DWORD buffer, DWORD rate, DWORD channels, DWORD bitsPerSample);
HRESULT DsDrvSetFrequency(DWORD buffer, DWORD rate);
HRESULT DsDrvSetVolumePan(DWORD buffer, DWORD left, DWORD right);

# Types of wingdi.h and windef.h that ddraw.h names.
handle HMONITOR;
struct PALETTEENTRY { BYTE peRed; BYTE peGreen; BYTE peBlue; BYTE peFlags; };
type LPPALETTEENTRY ptr "PALETTEENTRY *";
struct RGNDATAHEADER { DWORD dwSize; DWORD iType; DWORD nCount; DWORD nRgnSize; RECT rcBound; };
struct RGNDATA { RGNDATAHEADER rdh; CHAR Buffer[1]; };
type LPRGNDATA ptr "RGNDATA *";
const PC_RESERVED 0x01;
const PC_EXPLICIT 0x02;
const PC_NOCOLLAPSE 0x04;
const RDH_RECTANGLES 1;

# What the Win32 front ends of the games call beyond the functions the SDK
# described so far. The branch arm64-cxx names the
# same gap; at the merge one description of each stays.
dll GDI32;
const CBM_INIT 4;
# Packed to two bytes in wingdi.h and winuser.h; every member lies where one
# byte packs it.
struct BITMAPFILEHEADER packed { WORD bfType; DWORD bfSize; WORD bfReserved1; WORD bfReserved2; DWORD bfOffBits; };
struct DLGTEMPLATE packed { DWORD style; DWORD dwExtendedStyle; WORD cdit; SHORT x; SHORT y; SHORT cx; SHORT cy; };
struct DLGITEMTEMPLATE packed { DWORD style; DWORD dwExtendedStyle; SHORT x; SHORT y; SHORT cx; SHORT cy; WORD id; };
HBITMAP CreateDIBitmap(HDC hdc, in BITMAPINFOHEADER* pbmih, DWORD flInit, LPCVOID pjBits, in BITMAPINFO* pbmi, UINT iUsage);
dll USER32;
BOOL UnionRect(RECT* lprcDst, in RECT* lprcSrc1, in RECT* lprcSrc2);
HCURSOR GetCursor();
INT_PTR DialogBoxIndirectParamA(HINSTANCE hInstance, LPCVOID hDialogTemplate, HWND hWndParent, DLGPROC lpDialogFunc, LPARAM dwInitParam);
