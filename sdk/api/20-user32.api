# Icons from resource bytes, for programs that read them out of files themselves.
struct ICONINFO { BOOL fIcon; DWORD xHotspot; DWORD yHotspot; HBITMAP hbmMask; HBITMAP hbmColor; };
HICON CreateIconFromResourceEx(LPBYTE presbits, DWORD dwResSize, BOOL fIcon, DWORD dwVer, int cxDesired, int cyDesired, UINT Flags);
int LookupIconIdFromDirectoryEx(LPBYTE presbits, BOOL fIcon, int cxDesired, int cyDesired, UINT Flags);
BOOL GetIconInfo(HICON hIcon, out ICONINFO* piconinfo);
HICON CreateIconIndirect(in ICONINFO* piconinfo);

# Hooks. The procedure of a hook receives in lParam what its type says, and
# for WH_CBT what its code says.
struct CWPSTRUCT { LPARAM lParam; WPARAM wParam; UINT message; HWND hwnd; };
struct MOUSEHOOKSTRUCT { POINT pt; HWND hwnd; UINT wHitTestCode; ULONG_PTR dwExtraInfo; };
struct CBTACTIVATESTRUCT { BOOL fMouse; HWND hWndActive; };
struct CBT_CREATEWNDA { CREATESTRUCTA* lpcs deep; HWND hwndInsertAfter; };
callback LRESULT HOOKPROC(int code, WPARAM wParam, LPARAM lParam);
callback LRESULT HOOKPROC_MESSAGE(int code, WPARAM wParam, inout MSG* lParam);
callback LRESULT HOOKPROC_CALLWNDPROC(int code, WPARAM wParam, in CWPSTRUCT* lParam);
callback LRESULT HOOKPROC_MOUSE(int code, WPARAM wParam, in MOUSEHOOKSTRUCT* lParam);
callback LRESULT HOOKPROC_CBT(int code, WPARAM wParam, LPARAM lParam);
hook -1 HOOKPROC_MESSAGE;
hook 3 HOOKPROC_MESSAGE;
hook 6 HOOKPROC_MESSAGE;
hook 4 HOOKPROC_CALLWNDPROC;
hook 7 HOOKPROC_MOUSE;
hook 5 HOOKPROC_CBT;
code HOOKPROC_CBT 3 lparam inout CBT_CREATEWNDA;
code HOOKPROC_CBT 5 lparam in CBTACTIVATESTRUCT;
code HOOKPROC_CBT 6 lparam in MOUSEHOOKSTRUCT;
const WH_MSGFILTER (-1);
const WH_KEYBOARD 2;
const WH_GETMESSAGE 3;
const WH_CALLWNDPROC 4;
const WH_CBT 5;
const WH_SYSMSGFILTER 6;
const WH_MOUSE 7;
const WH_SHELL 10;
const HC_ACTION 0;
const HC_NOREMOVE 3;
const HCBT_MOVESIZE 0;
const HCBT_MINMAX 1;
const HCBT_CREATEWND 3;
const HCBT_DESTROYWND 4;
const HCBT_ACTIVATE 5;
const HCBT_CLICKSKIPPED 6;
const HCBT_KEYSKIPPED 7;
const HCBT_SYSCOMMAND 8;
const HCBT_SETFOCUS 9;
const MSGF_DIALOGBOX 0;
const MSGF_MENU 2;
HHOOK SetWindowsHookExA(int idHook, HOOKPROC lpfn select(idHook), HINSTANCE hmod, DWORD dwThreadId);
BOOL UnhookWindowsHookEx(HHOOK hhk);
LRESULT CallNextHookEx(HHOOK hhk, int nCode, WPARAM wParam, LPARAM lParam passback);

