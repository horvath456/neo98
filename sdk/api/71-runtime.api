# What the C and C++ runtimes of the SDK (sdk/crt, libc++) call beyond the
# first stages: the text of a system error, the kind of a handle. Error
# numbers of winerror.h for the codes std::system_category knows.
dll KERNEL32;
const FORMAT_MESSAGE_ALLOCATE_BUFFER 0x0100;
const FORMAT_MESSAGE_IGNORE_INSERTS 0x0200;
const FORMAT_MESSAGE_FROM_STRING 0x0400;
const FORMAT_MESSAGE_FROM_HMODULE 0x0800;
