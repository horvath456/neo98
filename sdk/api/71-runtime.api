# With FORMAT_MESSAGE_ALLOCATE_BUFFER the buffer argument is where the system
# puts the address of the text it allocated (LocalFree releases it).
DWORD FormatMessageA(DWORD dwFlags, LPCVOID lpSource, DWORD dwMessageId, DWORD dwLanguageId, LPSTR lpBuffer receives(LPSTR) when(dwFlags, 0x100, 0x100), DWORD nSize, PVOID Arguments);
BOOL GetConsoleMode(HANDLE hConsoleHandle, LPDWORD lpMode);
DWORD GetFileType(HANDLE hFile);
BOOL AreFileApisANSI();
