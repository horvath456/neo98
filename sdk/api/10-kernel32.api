# KERNEL32: process, memory, files, threads, strings.
callback DWORD LPTHREAD_START_ROUTINE(LPVOID lpParameter);

struct STARTUPINFOA { DWORD cb sizeof; LPSTR lpReserved; LPSTR lpDesktop; LPSTR lpTitle; DWORD dwX; DWORD dwY; DWORD dwXSize; DWORD dwYSize;
    DWORD dwXCountChars; DWORD dwYCountChars; DWORD dwFillAttribute; DWORD dwFlags; WORD wShowWindow; WORD cbReserved2;
    LPBYTE lpReserved2; HANDLE hStdInput; HANDLE hStdOutput; HANDLE hStdError; };
struct PROCESS_INFORMATION { HANDLE hProcess; HANDLE hThread; DWORD dwProcessId; DWORD dwThreadId; };
struct MEMORY_BASIC_INFORMATION { PVOID BaseAddress; PVOID AllocationBase; DWORD AllocationProtect; SIZE_T RegionSize; DWORD State; DWORD Protect; DWORD Type; };
struct SYSTEM_INFO { DWORD dwOemId; DWORD dwPageSize; LPVOID lpMinimumApplicationAddress; LPVOID lpMaximumApplicationAddress;
    DWORD_PTR dwActiveProcessorMask; DWORD dwNumberOfProcessors; DWORD dwProcessorType; DWORD dwAllocationGranularity; WORD wProcessorLevel; WORD wProcessorRevision; };
struct MEMORYSTATUS { DWORD dwLength sizeof; DWORD dwMemoryLoad; SIZE_T dwTotalPhys; SIZE_T dwAvailPhys; SIZE_T dwTotalPageFile; SIZE_T dwAvailPageFile; SIZE_T dwTotalVirtual; SIZE_T dwAvailVirtual; };
struct OSVERSIONINFOA { DWORD dwOSVersionInfoSize; DWORD dwMajorVersion; DWORD dwMinorVersion; DWORD dwBuildNumber; DWORD dwPlatformId; CHAR szCSDVersion[128]; };
struct WIN32_FIND_DATAA { DWORD dwFileAttributes; FILETIME ftCreationTime; FILETIME ftLastAccessTime; FILETIME ftLastWriteTime;
    DWORD nFileSizeHigh; DWORD nFileSizeLow; DWORD dwReserved0; DWORD dwReserved1; CHAR cFileName[260]; CHAR cAlternateFileName[14]; };
# The system keeps its own record in this memory; the program only supplies it.
struct CRITICAL_SECTION opaque { PVOID DebugInfo; LONG LockCount; LONG RecursionCount; HANDLE OwningThread; HANDLE LockSemaphore; ULONG_PTR SpinCount; };

const STD_INPUT_HANDLE ((DWORD)-10);
const STD_OUTPUT_HANDLE ((DWORD)-11);
const STD_ERROR_HANDLE ((DWORD)-12);
const GENERIC_READ 0x80000000UL;
const GENERIC_WRITE 0x40000000UL;
const FILE_SHARE_READ 1;
const FILE_SHARE_WRITE 2;
const CREATE_NEW 1;
const CREATE_ALWAYS 2;
const OPEN_EXISTING 3;
const OPEN_ALWAYS 4;
const TRUNCATE_EXISTING 5;
const FILE_ATTRIBUTE_READONLY 0x01;
const FILE_ATTRIBUTE_DIRECTORY 0x10;
const FILE_ATTRIBUTE_NORMAL 0x80;
const INVALID_FILE_ATTRIBUTES ((DWORD)-1);
const INVALID_FILE_SIZE ((DWORD)-1);
const FILE_BEGIN 0;
const FILE_CURRENT 1;
const FILE_END 2;
const MAX_PATH 260;
const HEAP_ZERO_MEMORY 0x08;
const MEM_COMMIT 0x1000;
const MEM_RESERVE 0x2000;
const MEM_DECOMMIT 0x4000;
const MEM_RELEASE 0x8000;
const MEM_FREE 0x10000;
const PAGE_NOACCESS 0x01;
const PAGE_READONLY 0x02;
const PAGE_READWRITE 0x04;
const PAGE_EXECUTE_READ 0x20;
const GMEM_FIXED 0x0000;
const GMEM_MOVEABLE 0x0002;
const GMEM_ZEROINIT 0x0040;
const GHND 0x0042;
const LMEM_FIXED 0x0000;
const LMEM_ZEROINIT 0x0040;
const LPTR 0x0040;
const INFINITE 0xFFFFFFFFUL;
const WAIT_OBJECT_0 0;
const WAIT_TIMEOUT 258;
const WAIT_FAILED ((DWORD)-1);
const STILL_ACTIVE 259;
const CREATE_SUSPENDED 0x04;
const TLS_OUT_OF_INDEXES ((DWORD)-1);
const ERROR_SUCCESS 0;
const ERROR_FILE_NOT_FOUND 2;
const ERROR_PATH_NOT_FOUND 3;
const ERROR_ACCESS_DENIED 5;
const ERROR_INVALID_HANDLE 6;
const ERROR_NOT_ENOUGH_MEMORY 8;
const ERROR_INVALID_PARAMETER 87;
const ERROR_ALREADY_EXISTS 183;
const ERROR_BAD_EXE_FORMAT 193;
const CP_ACP 0;
const STARTF_USESHOWWINDOW 0x01;

dll KERNEL32;
HANDLE GetStdHandle(DWORD nStdHandle);
BOOL WriteFile(HANDLE hFile, LPCVOID lpBuffer, DWORD nNumberOfBytesToWrite, LPDWORD lpNumberOfBytesWritten, LPVOID lpOverlapped);
BOOL ReadFile(HANDLE hFile, LPVOID lpBuffer, DWORD nNumberOfBytesToRead, LPDWORD lpNumberOfBytesRead, LPVOID lpOverlapped);
HANDLE CreateFileA(LPCSTR lpFileName, DWORD dwDesiredAccess, DWORD dwShareMode, in SECURITY_ATTRIBUTES* lpSecurityAttributes, DWORD dwCreationDisposition, DWORD dwFlagsAndAttributes, HANDLE hTemplateFile);
BOOL CloseHandle(HANDLE hObject);
DWORD SetFilePointer(HANDLE hFile, LONG lDistanceToMove, LPLONG lpDistanceToMoveHigh, DWORD dwMoveMethod);
DWORD GetFileSize(HANDLE hFile, LPDWORD lpFileSizeHigh);
BOOL SetEndOfFile(HANDLE hFile);
BOOL FlushFileBuffers(HANDLE hFile);
BOOL DeleteFileA(LPCSTR lpFileName);
BOOL MoveFileA(LPCSTR lpExistingFileName, LPCSTR lpNewFileName);
BOOL CopyFileA(LPCSTR lpExistingFileName, LPCSTR lpNewFileName, BOOL bFailIfExists);
BOOL CreateDirectoryA(LPCSTR lpPathName, in SECURITY_ATTRIBUTES* lpSecurityAttributes);
BOOL RemoveDirectoryA(LPCSTR lpPathName);
DWORD GetFileAttributesA(LPCSTR lpFileName);
BOOL SetFileAttributesA(LPCSTR lpFileName, DWORD dwFileAttributes);
HANDLE FindFirstFileA(LPCSTR lpFileName, out WIN32_FIND_DATAA* lpFindFileData);
BOOL FindNextFileA(HANDLE hFindFile, out WIN32_FIND_DATAA* lpFindFileData);
BOOL FindClose(HANDLE hFindFile);
DWORD GetTempPathA(DWORD nBufferLength, LPSTR lpBuffer);
UINT GetTempFileNameA(LPCSTR lpPathName, LPCSTR lpPrefixString, UINT uUnique, LPSTR lpTempFileName);
DWORD GetCurrentDirectoryA(DWORD nBufferLength, LPSTR lpBuffer);
BOOL SetCurrentDirectoryA(LPCSTR lpPathName);
UINT GetWindowsDirectoryA(LPSTR lpBuffer, UINT uSize);
UINT GetSystemDirectoryA(LPSTR lpBuffer, UINT uSize);
DWORD GetFullPathNameA(LPCSTR lpFileName, DWORD nBufferLength, LPSTR lpBuffer, out LPSTR* lpFilePart);
DWORD GetLastError();
void SetLastError(DWORD dwErrCode);
void ExitProcess(UINT uExitCode);
LPSTR GetCommandLineA();
HMODULE GetModuleHandleA(LPCSTR lpModuleName);
DWORD GetModuleFileNameA(HMODULE hModule, LPSTR lpFilename, DWORD nSize);
HMODULE LoadLibraryA(LPCSTR lpLibFileName);
BOOL FreeLibrary(HMODULE hLibModule);
LPVOID GetProcAddress(HMODULE hModule, LPCSTR lpProcName);
HANDLE GetProcessHeap();
LPVOID HeapAlloc(HANDLE hHeap, DWORD dwFlags, SIZE_T dwBytes);
LPVOID HeapReAlloc(HANDLE hHeap, DWORD dwFlags, LPVOID lpMem, SIZE_T dwBytes);
BOOL HeapFree(HANDLE hHeap, DWORD dwFlags, LPVOID lpMem);
SIZE_T HeapSize(HANDLE hHeap, DWORD dwFlags, LPCVOID lpMem);
HANDLE HeapCreate(DWORD flOptions, SIZE_T dwInitialSize, SIZE_T dwMaximumSize);
BOOL HeapDestroy(HANDLE hHeap);
LPVOID VirtualAlloc(LPVOID lpAddress, SIZE_T dwSize, DWORD flAllocationType, DWORD flProtect);
BOOL VirtualFree(LPVOID lpAddress, SIZE_T dwSize, DWORD dwFreeType);
BOOL VirtualProtect(LPVOID lpAddress, SIZE_T dwSize, DWORD flNewProtect, LPDWORD lpflOldProtect);
SIZE_T VirtualQuery(LPCVOID lpAddress, out MEMORY_BASIC_INFORMATION* lpBuffer, SIZE_T dwLength sizeof(lpBuffer)) sizeresult;
HGLOBAL GlobalAlloc(UINT uFlags, SIZE_T dwBytes);
LPVOID GlobalLock(HGLOBAL hMem);
BOOL GlobalUnlock(HGLOBAL hMem);
HGLOBAL GlobalFree(HGLOBAL hMem);
SIZE_T GlobalSize(HGLOBAL hMem);
HLOCAL LocalAlloc(UINT uFlags, SIZE_T uBytes);
HLOCAL LocalFree(HLOCAL hMem);
int lstrlenA(LPCSTR lpString);
LPSTR lstrcpyA(LPSTR lpString1, LPCSTR lpString2);
LPSTR lstrcpynA(LPSTR lpString1, LPCSTR lpString2, int iMaxLength);
LPSTR lstrcatA(LPSTR lpString1, LPCSTR lpString2);
int lstrcmpA(LPCSTR lpString1, LPCSTR lpString2);
int lstrcmpiA(LPCSTR lpString1, LPCSTR lpString2);
DWORD GetTickCount();
void Sleep(DWORD dwMilliseconds);
HANDLE CreateThread(in SECURITY_ATTRIBUTES* lpThreadAttributes, SIZE_T dwStackSize, LPTHREAD_START_ROUTINE lpStartAddress, LPVOID lpParameter, DWORD dwCreationFlags, LPDWORD lpThreadId);
void ExitThread(DWORD dwExitCode);
BOOL GetExitCodeThread(HANDLE hThread, LPDWORD lpExitCode);
DWORD ResumeThread(HANDLE hThread);
DWORD GetCurrentThreadId();
DWORD GetCurrentProcessId();
HANDLE GetCurrentProcess();
HANDLE GetCurrentThread();
DWORD WaitForSingleObject(HANDLE hHandle, DWORD dwMilliseconds);
DWORD WaitForMultipleObjects(DWORD nCount, in HANDLE* lpHandles count(nCount), BOOL bWaitAll, DWORD dwMilliseconds);
HANDLE CreateEventA(in SECURITY_ATTRIBUTES* lpEventAttributes, BOOL bManualReset, BOOL bInitialState, LPCSTR lpName);
BOOL SetEvent(HANDLE hEvent);
BOOL ResetEvent(HANDLE hEvent);
HANDLE CreateMutexA(in SECURITY_ATTRIBUTES* lpMutexAttributes, BOOL bInitialOwner, LPCSTR lpName);
BOOL ReleaseMutex(HANDLE hMutex);
HANDLE CreateSemaphoreA(in SECURITY_ATTRIBUTES* lpSemaphoreAttributes, LONG lInitialCount, LONG lMaximumCount, LPCSTR lpName);
BOOL ReleaseSemaphore(HANDLE hSemaphore, LONG lReleaseCount, LPLONG lpPreviousCount);
void InitializeCriticalSection(CRITICAL_SECTION* lpCriticalSection);
void EnterCriticalSection(CRITICAL_SECTION* lpCriticalSection);
void LeaveCriticalSection(CRITICAL_SECTION* lpCriticalSection);
void DeleteCriticalSection(CRITICAL_SECTION* lpCriticalSection);
DWORD TlsAlloc();
BOOL TlsFree(DWORD dwTlsIndex);
LPVOID TlsGetValue(DWORD dwTlsIndex);
BOOL TlsSetValue(DWORD dwTlsIndex, LPVOID lpTlsValue);
void GetSystemTime(SYSTEMTIME* lpSystemTime);
void GetLocalTime(SYSTEMTIME* lpSystemTime);
DWORD GetVersion();
BOOL GetVersionExA(OSVERSIONINFOA* lpVersionInformation);
void GetSystemInfo(out SYSTEM_INFO* lpSystemInfo);
void GlobalMemoryStatus(inout MEMORYSTATUS* lpBuffer);
void OutputDebugStringA(LPCSTR lpOutputString);
int MulDiv(int nNumber, int nNumerator, int nDenominator);
BOOL QueryPerformanceCounter(LARGE_INTEGER* lpPerformanceCount);
BOOL QueryPerformanceFrequency(LARGE_INTEGER* lpFrequency);
BOOL CreateProcessA(LPCSTR lpApplicationName, LPSTR lpCommandLine, in SECURITY_ATTRIBUTES* lpProcessAttributes, in SECURITY_ATTRIBUTES* lpThreadAttributes, BOOL bInheritHandles, DWORD dwCreationFlags, LPVOID lpEnvironment, LPCSTR lpCurrentDirectory, in STARTUPINFOA* lpStartupInfo, out PROCESS_INFORMATION* lpProcessInformation);
BOOL GetExitCodeProcess(HANDLE hProcess, LPDWORD lpExitCode);
BOOL TerminateProcess(HANDLE hProcess, UINT uExitCode);
UINT WinExec(LPCSTR lpCmdLine, UINT uCmdShow);
DWORD GetEnvironmentVariableA(LPCSTR lpName, LPSTR lpBuffer, DWORD nSize);
BOOL SetEnvironmentVariableA(LPCSTR lpName, LPCSTR lpValue);
HRSRC FindResourceA(HMODULE hModule, LPCSTR lpName, LPCSTR lpType);
HGLOBAL LoadResource(HMODULE hModule, HRSRC hResInfo);
LPVOID LockResource(HGLOBAL hResData);
DWORD SizeofResource(HMODULE hModule, HRSRC hResInfo);
int MultiByteToWideChar(UINT CodePage, DWORD dwFlags, LPCSTR lpMultiByteStr, int cbMultiByte, LPWSTR lpWideCharStr, int cchWideChar);
int WideCharToMultiByte(UINT CodePage, DWORD dwFlags, LPCWSTR lpWideCharStr, int cchWideChar, LPSTR lpMultiByteStr, int cbMultiByte, LPCSTR lpDefaultChar, LPBOOL lpUsedDefaultChar);
UINT GetACP();
BOOL SetConsoleTitleA(LPCSTR lpConsoleTitle);
BOOL WriteConsoleA(HANDLE hConsoleOutput, LPCVOID lpBuffer, DWORD nNumberOfCharsToWrite, LPDWORD lpNumberOfCharsWritten, LPVOID lpReserved);
DWORD GetPrivateProfileStringA(LPCSTR lpAppName, LPCSTR lpKeyName, LPCSTR lpDefault, LPSTR lpReturnedString, DWORD nSize, LPCSTR lpFileName);
UINT GetPrivateProfileIntA(LPCSTR lpAppName, LPCSTR lpKeyName, INT nDefault, LPCSTR lpFileName);
BOOL WritePrivateProfileStringA(LPCSTR lpAppName, LPCSTR lpKeyName, LPCSTR lpString, LPCSTR lpFileName);

# Stage 2: drives, power, file times.
struct SYSTEM_POWER_STATUS { BYTE ACLineStatus; BYTE BatteryFlag; BYTE BatteryLifePercent; union { BYTE Reserved1; BYTE SystemStatusFlag; }; DWORD BatteryLifeTime; DWORD BatteryFullLifeTime; };
const DRIVE_UNKNOWN 0;
const DRIVE_NO_ROOT_DIR 1;
const DRIVE_REMOVABLE 2;
const DRIVE_FIXED 3;
const DRIVE_REMOTE 4;
const DRIVE_CDROM 5;
const DRIVE_RAMDISK 6;
BOOL GetDiskFreeSpaceA(LPCSTR lpRootPathName, LPDWORD lpSectorsPerCluster, LPDWORD lpBytesPerSector, LPDWORD lpNumberOfFreeClusters, LPDWORD lpTotalNumberOfClusters);
DWORD GetLogicalDrives();
UINT GetDriveTypeA(LPCSTR lpRootPathName);
BOOL GetSystemPowerStatus(SYSTEM_POWER_STATUS* lpSystemPowerStatus);
BOOL LocalFileTimeToFileTime(in FILETIME* lpLocalFileTime, FILETIME* lpFileTime);
BOOL FileTimeToLocalFileTime(in FILETIME* lpFileTime, FILETIME* lpLocalFileTime);
BOOL SystemTimeToFileTime(in SYSTEMTIME* lpSystemTime, FILETIME* lpFileTime);
BOOL FileTimeToSystemTime(in FILETIME* lpFileTime, SYSTEMTIME* lpSystemTime);
void GetSystemTimeAsFileTime(FILETIME* lpSystemTimeAsFileTime);
LONG CompareFileTime(in FILETIME* lpFileTime1, in FILETIME* lpFileTime2);
BOOL GetFileTime(HANDLE hFile, FILETIME* lpCreationTime, FILETIME* lpLastAccessTime, FILETIME* lpLastWriteTime);
BOOL SetFileTime(HANDLE hFile, in FILETIME* lpCreationTime, in FILETIME* lpLastAccessTime, in FILETIME* lpLastWriteTime);

# Paths, the environment and how the process was started.
DWORD GetShortPathNameA(LPCSTR lpszLongPath, LPSTR lpszShortPath, DWORD cchBuffer);
DWORD SearchPathA(LPCSTR lpPath, LPCSTR lpFileName, LPCSTR lpExtension, DWORD nBufferLength, LPSTR lpBuffer, out LPSTR* lpFilePart);
DWORD ExpandEnvironmentStringsA(LPCSTR lpSrc, LPSTR lpDst, DWORD nSize);
void GetStartupInfoA(out STARTUPINFOA* lpStartupInfo);
HMODULE LoadLibraryExA(LPCSTR lpLibFileName, HANDLE hFile, DWORD dwFlags);

# The reasons a DLL entry is called for.
const DLL_PROCESS_DETACH 0;
const DLL_PROCESS_ATTACH 1;
const DLL_THREAD_ATTACH 2;
const DLL_THREAD_DETACH 3;
const LOAD_LIBRARY_AS_DATAFILE 0x00000002;
const DONT_RESOLVE_DLL_REFERENCES 0x00000001;

# Windows 98 file metadata and volume queries used by libc++'s private adapter.
struct BY_HANDLE_FILE_INFORMATION { DWORD dwFileAttributes; FILETIME ftCreationTime; FILETIME ftLastAccessTime; FILETIME ftLastWriteTime;
    DWORD dwVolumeSerialNumber; DWORD nFileSizeHigh; DWORD nFileSizeLow; DWORD nNumberOfLinks; DWORD nFileIndexHigh; DWORD nFileIndexLow; };
struct WIN32_FILE_ATTRIBUTE_DATA { DWORD dwFileAttributes; FILETIME ftCreationTime; FILETIME ftLastAccessTime; FILETIME ftLastWriteTime; DWORD nFileSizeHigh; DWORD nFileSizeLow; };
BOOL GetFileInformationByHandle(HANDLE hFile, out BY_HANDLE_FILE_INFORMATION* lpFileInformation);
BOOL GetFileAttributesExA(LPCSTR lpFileName, int fInfoLevelId, out WIN32_FILE_ATTRIBUTE_DATA* lpFileInformation);
DWORD GetLongPathNameA(LPCSTR lpszShortPath, LPSTR lpszLongPath, DWORD cchBuffer);
BOOL GetDiskFreeSpaceExA(LPCSTR lpDirectoryName, ULONGLONG* lpFreeBytesAvailable, ULONGLONG* lpTotalNumberOfBytes, ULONGLONG* lpTotalNumberOfFreeBytes);
