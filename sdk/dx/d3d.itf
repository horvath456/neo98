# The interfaces of Direct3D 7 and of the versions before it for d3d.h of the
# NEO98 SDK: name, IID and the methods in the order of the method table, after
# the three of IUnknown. tools/arm64_dx.py writes the declarations for C and
# C++ and the call macros from this list; tools/test_arm64_dx_headers.py
# checks every IID and the place of every method against the header of
# mingw-w64. DDRAW.DLL of the SDK implements IDirect3D7, IDirect3DDevice7 and
# IDirect3DVertexBuffer7 (sdk/dx/ddraw/d3d_*.c); the older ones are declared
# for programs that name them.
guid IID_IDirect3DRampDevice {F2086B20-259F-11CF-A31A-00AA00B93356}
guid IID_IDirect3DRGBDevice {A4665C60-2673-11CF-A31A-00AA00B93356}
