guid IID_IDirect3DRefDevice {50936643-13E9-11D1-89AA-00A0C9054129}
guid IID_IDirect3DNullDevice {8767DF22-BACC-11D1-8969-00A0C90629A8}
guid IID_IDirect3DTnLHalDevice {F5049E78-4861-11D2-A407-00A0C90629A8}

