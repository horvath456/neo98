#include <windows.h>
#include "window.h"

IDM_MAIN MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Reset counter\tF2", IDM_FILE_RESET
        MENUITEM SEPARATOR
        MENUITEM "E&xit", IDM_FILE_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Ellipse", IDM_VIEW_ELLIPSE
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About...", IDM_HELP_ABOUT
    END
END

IDD_ABOUT DIALOG 20, 20, 180, 76
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About the ARM64 sample"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT "Your name:", -1, 8, 10, 44, 10
    EDITTEXT IDC_NAME, 56, 8, 116, 12, ES_AUTOHSCROLL
    LTEXT "", IDC_GREETING, 8, 30, 164, 10
    DEFPUSHBUTTON "OK", IDOK, 66, 54, 50, 14
    PUSHBUTTON "Cancel", IDCANCEL, 122, 54, 50, 14
END

STRINGTABLE
BEGIN
    IDS_TITLE "ARM64 window sample"
    IDS_GREETING "Hello, %s."
END
