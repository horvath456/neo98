// tools/test_dialog_center_native.py: a 4.0 dialog with DS_CENTER (800h), a
// caption without WS_SYSMENU (WS_POPUP | WS_CAPTION | WS_MINIMIZEBOX |
// DS_MODALFRAME) and an SS_BITMAP (0Eh | SS_CENTERIMAGE 200h) control that
// names its picture by number.
114 BITMAP "dialog_center.bmp"
1 DIALOGEX 0, 0, 160, 80
STYLE 0x80C20880
CAPTION "Center"
BEGIN
    CONTROL 114, 100, "STATIC", 0x1000020E, 10, 10, 60, 30
END
