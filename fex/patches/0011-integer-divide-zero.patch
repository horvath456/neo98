+// NEO98: ARM division returns zero for a zero divisor; x86 raises #DE.
+// Keep the faulting RIP and all dividend registers for guest SEH to inspect
+// or repair. Materialize the old flags before splitting the IR block.
+void OpDispatchBuilder::CheckDivideByZero(OpcodeArgs, Ref Divisor) {
+  CalculateDeferredFlags();
+  auto Jump = CondJump(Divisor, CondClass::NEQ);
+  auto FaultBlock = CreateNewCodeBlockAfter(GetCurrentBlock());
+  SetFalseJumpTarget(Jump, FaultBlock);
+  SetCurrentCodeBlock(FaultBlock);
+  StartNewBlock();
+
+  _StoreContextGPR(GetGPROpSize(), GetRelocatedPC(Op, -Op->InstSize), offsetof(FEXCore::Core::CPUState, rip));
+  BreakDefinition Reason {};
+  Reason.Signal = Core::FAULT_SIGFPE;
+  Reason.TrapNumber = X86State::X86_TRAPNO_DE;
+  Reason.si_code = 1; // FPE_INTDIV
+  Break(Reason);
+
+  auto ContinueBlock = CreateNewCodeBlockAfter(FaultBlock);
+  SetTrueJumpTarget(Jump, ContinueBlock);
+  SetCurrentCodeBlock(ContinueBlock);
+  StartNewBlock();
+}
