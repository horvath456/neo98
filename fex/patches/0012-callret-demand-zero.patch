--- a/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
+++ b/FEXCore/include/FEXCore/Utils/AllocatorHooks.h
@@ -259,6 +259,21 @@
 void SetupAllocatorHooks(void (*)(const char* name, const void* address, size_t size));
 #endif
 
+// The embedder gives the call-return predictor a private, page-aligned RW
+// mapping. Replace only that mapping with demand-zero pages on Darwin.
+// MADV_DONTNEED retains bytes here; memset faults in every one of the 4 MiB.
+// Do not use this for the general discard API, which also sees JIT mappings.
+inline void VirtualResetCallRet(void* Ptr, size_t Size) {
+#ifdef __APPLE__
+  const size_t Page = static_cast<size_t>(getpagesize());
+  if (!(reinterpret_cast<uintptr_t>(Ptr) % Page) && !(Size % Page) && Size &&
+      ::mmap(Ptr, Size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == Ptr) {
+    return;
+  }
+#endif
+  VirtualDontNeed(Ptr, Size);
+}
+
 struct FEXAllocOperators {
   FEXAllocOperators() = default;
 
