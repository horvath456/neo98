+#ifdef __APPLE__
+// NEO98 spike: make MAP_JIT pages writable for this thread for the scope.
+struct NEO98JitWriteScope {
+  // Nested scopes (ExitFunctionLink compiles the target block) switch only once.
+  static inline thread_local unsigned Depth = 0;
+  NEO98JitWriteScope() { if (Depth++ == 0) pthread_jit_write_protect_np(0); }
+  ~NEO98JitWriteScope() { if (--Depth == 0) pthread_jit_write_protect_np(1); }
+};
+#endif
 
